<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:CompileBindings="False"
             x:Class="AuSoCom.Controls.SceneControlsView">
    <Grid ColumnDefinitions="Auto,4,Auto,4,*">
        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="68,*">
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="4">
                    <TextBlock Text="Inputs" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Click="AddInputButtonClicked" ToolTip.Tip="Add input" AutomationProperties.Name="Add input">
                        <PathIcon Data="{StaticResource AddIcon}" Foreground="#2E7D32" Width="16" Height="16" />
                    </Button>
                    <Button Click="RemoveInputButtonClicked" ToolTip.Tip="Remove input" AutomationProperties.Name="Remove input">
                        <PathIcon Data="{StaticResource RemoveIcon}" Foreground="#C62828" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="68,*">
                <Grid Grid.Column="0"
                      RowDefinitions="32,84,36,164,32,32,32"
                      RowSpacing="4"
                      Margin="4,4,8,4">
                    <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Top" TextAlignment="Left" />
                    <TextBlock Grid.Row="1" Text="Gain" VerticalAlignment="Top" TextAlignment="Left"
                               ToolTip.Tip="Adjusts the input signal level. 0 dB leaves it unchanged; positive values boost it and negative values reduce it." />
                    <TextBlock Grid.Row="2" Text="Mute" VerticalAlignment="Top" TextAlignment="Left"
                               ToolTip.Tip="Turns this input's sound off without removing it from the scene. Turn it back on to hear it again." />
                    <TextBlock Grid.Row="3" Text="Fader" VerticalAlignment="Top" TextAlignment="Left"
                               ToolTip.Tip="Controls this input's volume in the scene. Move it up to make the input louder or down to make it quieter." />
                    <TextBlock Grid.Row="4" Text="Delay" VerticalAlignment="Top" TextAlignment="Left"
                               ToolTip.Tip="Waits this long after the scene starts before this input becomes active. Live audio received during the wait is discarded, not played later." />
                    <TextBlock Grid.Row="5" Text="Fade-in" VerticalAlignment="Top" TextAlignment="Left"
                               ToolTip.Tip="Sets how long this input takes to smoothly reach its set level when it becomes active." />
                    <TextBlock Grid.Row="6" Text="Fade-out" VerticalAlignment="Top" TextAlignment="Left"
                               ToolTip.Tip="Sets how long this input takes to smoothly fade to silence when the scene is stopped." />
                </Grid>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Name="InputsPanel" Orientation="Horizontal" Spacing="8" Margin="0,4" />
                </ScrollViewer>
            </Grid>
        </DockPanel>
        <GridSplitter Grid.Column="1" />
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="4">
                <TextBlock Text="Outputs" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button Click="AddOutputButtonClicked" ToolTip.Tip="Add output" AutomationProperties.Name="Add output">
                    <PathIcon Data="{StaticResource AddIcon}" Foreground="#2E7D32" Width="16" Height="16" />
                </Button>
                <Button Click="RemoveOutputButtonClicked" ToolTip.Tip="Remove output" AutomationProperties.Name="Remove output">
                    <PathIcon Data="{StaticResource RemoveIcon}" Foreground="#C62828" Width="16" Height="16" />
                </Button>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Name="OutputsPanel" Orientation="Horizontal" Spacing="8" Margin="0,4" />
            </ScrollViewer>
        </DockPanel>
        <GridSplitter Grid.Column="3" />
        <DockPanel Grid.Column="4">
            <TextBlock DockPanel.Dock="Top" Text="Routing matrix" FontWeight="Bold" Margin="4" />
            <DataGrid Name="RoutingMatrixGrid" AutoGenerateColumns="False" SelectionMode="Single"
                      CanUserResizeColumns="True" CellEditEnded="RoutingGridCellEditEnded">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Input" Width="*" Binding="{Binding InputName}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Percent" Width="100" Binding="{Binding Amount}" />
                    <DataGridTextColumn Header="Output" Width="*" Binding="{Binding OutputName}" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
